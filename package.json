{
  "name": "ecolife-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "gen:api": "node scripts/gen-api.mjs",
    "doctor": "expo-doctor",
    "test": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/check-envelope.mjs"
  },
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/query-async-storage-persister": "5.105.0",
    "@tanstack/react-query": "5.105.0",
    "@tanstack/react-query-persist-client": "5.105.0",
    "expo": "58.0.21",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-router": "58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.65.0",
    "nativewind": "4.2.7",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "^6.3.48",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/react": "~19.3.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.9.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "react"
      ]
    }
  }
}
