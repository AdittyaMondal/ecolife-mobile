# Copy to .env.local and fill in. Never commit a filled-in copy.

# Prism mock from ../ecolife-server/openapi.json (`pnpm mock` there). Real server is :4000.
# A physical device cannot reach `localhost` — use your machine's LAN IP, e.g.
# http://192.168.1.12:4010/api/v1
EXPO_PUBLIC_API_URL=http://localhost:4010/api/v1

# Error reporting. Optional in Sprint 0; leave blank.
EXPO_PUBLIC_SENTRY_DSN=
